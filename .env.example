# Copy to .env and fill in real values for local development.
# In production these must be set in the deployment environment;
# .env is only read as a convenience when present.

PORT=4000
ENV=development

# Postgres connection string. For Supabase, use the "Connection
# pooling" URI (port 6543, transaction mode) so short-lived
# connections behave well.
DATABASE_URL=

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase anon (publishable) key — sent as `apikey` header when
# this backend proxies to Supabase Auth for signup / login /
# refresh / logout.
SUPABASE_ANON_KEY=

# Note: no SUPABASE_JWT_SECRET. This backend verifies access tokens
# via the project's public JWKS (ES256), fetched at boot from
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json. Requires that the
# Supabase project has migrated to asymmetric signing keys under
# Dashboard → Auth → Signing Keys.

# Comma-separated list of allowed browser origins. No trailing
# slashes. Example: http://localhost:3000,https://app.example.com
CORS_ORIGIN=
